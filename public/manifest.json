{
  "name": "ZenNotes — Infinite Tree Outliner",
  "short_name": "ZenNotes",
  "description": "Infinite hierarchical tree outliner and distraction-free note taking workspace with bullet zoom and offline privacy.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#09090B",
  "theme_color": "#059669",
  "lang": "en",
  "categories": ["productivity", "utilities", "notes"],
  "share_target": {
    "action": "/?source=share-target",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
  "shortcuts": [
    {
      "name": "New Note",
      "short_name": "New Note",
      "description": "Create a new note in ZenNotes",
      "url": "/?action=new#app",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
